# NutriTrackPro Environment Variables
# Copy this to .env and fill in your values

# Database (PostgreSQL on Render, SQLite locally)
DATABASE_URL=postgresql://user:password@host:port/dbname
# For local development with SQLite:
# DATABASE_URL=sqlite:///./nutrition.db

# JWT Secret - generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-key-here

# USDA FoodData Central API Key - get from https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-api-key

# Roboflow API Key for food image classification - get from https://roboflow.com
ROBOFLOW_API_KEY=your-roboflow-api-key

# Groq API Key for AI meal suggestions - get from https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# SendGrid for email verification - get from https://app.sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com
BACKEND_URL=https://your-backend-url.onrender.com

# HuggingFace Token (optional, for model access)
HF_TOKEN=your-hf-token

# Google Gemini API Key (optional)
GEMINI_API_KEY=your-gemini-api-key